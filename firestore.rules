rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "admin@shinegroupjobs.com" ||
        request.auth.token.email == "admin@shinegroupjob.com" ||
        request.auth.token.email == "rentpe.support.in@gmail.com"
      );
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Jobs Collection
    match /jobs/{jobId} {
      allow read: if true; // Public job listings
      allow create, update, delete: if isAdmin() || isSignedIn();
    }

    // 3. Applications Collection
    match /applications/{applicationId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.applicantEmail == request.auth.token.email);
      allow create: if true; // Candidates can apply
      allow update, delete: if isAdmin();
    }

    // 4. Certificates Collection
    match /certificates/{certificateId} {
      allow read: if true; // Public verification of authentic certificates
      allow create: if true; // Direct candidate request
      allow update, delete: if isAdmin();
    }

    // 5. Site Settings Collection
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
